  INSERT INTO public.weeds (crop_id, name_en, name_te, scientific_name, weed_type, description_en, description_te, is_active, sort_order) VALUES
  (cotton_id, 'Parthenium', 'పార్థేనియం', 'Parthenium hysterophorus', 'broadleaf', 'Invasive weed causing allergies', 'అలర్జీలను కలిగించే ఆక్రమణ కలుపు మొక్క', true, 1),
  (cotton_id, 'Cynodon', 'గడ్డి', 'Cynodon dactylon', 'grass', 'Perennial grass weed', 'బహువార్షిక గడ్డి కలుపు మొక్క', true, 2);

  -- Insert Paddy Weeds
  INSERT INTO public.weeds (crop_id, name_en, name_te, scientific_name, weed_type, description_en, description_te, is_active, sort_order) VALUES
