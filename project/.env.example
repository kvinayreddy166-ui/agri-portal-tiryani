VITE_SUPABASE_URL=https://szxtfeiswxugxukztnst.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Turnstile — bot protection for login, sign-up, OTP & password reset
# 1. Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile (hostname: your app domain + localhost)
# 2. Put the public SITE KEY here. Leave empty to disable the widget entirely.
# 3. Enable CAPTCHA in Supabase Dashboard → Authentication → Attack Protection
#    (provider: Cloudflare Turnstile, same site/secret keys) so signIn/signUp/OTP calls are verified.
# 4. For Edge Functions (send-email-otp, register-officer, reset-password):
#    supabase secrets set TURNSTILE_SECRET_KEY=<your secret key>
VITE_TURNSTILE_SITE_KEY=

# Cloudflare R2 Officer Records Storage API (Cloudflare Worker)
# Set to your deployed worker URL, e.g., https://agronix-storage-api.<subdomain>.workers.dev
VITE_STORAGE_WORKER_URL=https://agronix-storage-api.workers.dev

# Dashboard widgets (optional)
# Google Maps: interactive 3D terrain; without key, satellite iframe is shown
VITE_GOOGLE_MAPS_API_KEY=
# OpenWeather: if empty, weather uses free Open-Meteo for Tiryani Mandal
VITE_OPENWEATHER_API_KEY=

# Crop disease AI — Google Gemini API Key for Crop Doctor AI photo pest & disease detection
# Uses models/gemini-3.8-flash via Google Gemini Interactions API (https://aistudio.google.com/docs/get-started)
# Free key available at https://aistudio.google.com/app/apikey (can also be entered in app UI)
VITE_GEMINI_API_KEY=
# Optional fallback TensorFlow.js model URL (PlantVillage-style)
VITE_CROP_MODEL_URL=

# Remote Sensing / Google Earth Engine
# Live Sentinel/GEE credentials belong in Supabase Edge Function secrets, not Vite frontend env.
# Function: supabase/functions/remote-sensing-live
# supabase secrets set GEE_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"...","project_id":"..."}'

# =====================================================================
# Knowledge Base (RAG) — server-side secrets (set via `supabase secrets set`)
# =====================================================================
# These are NOT Vite env vars (no VITE_ prefix) — they live in Supabase
# Edge Function secrets and are never exposed to the browser.
#
#   supabase secrets set OLLAMA_BASE_URL=http://your-ollama-server:11434
#   supabase secrets set OLLAMA_CHAT_MODEL=llama3.2
#   supabase secrets set OLLAMA_EMBEDDING_MODEL=bge-m3
#   supabase secrets set RAG_EMBEDDING_DIM=1024
#   supabase secrets set RAG_ENABLED=true
#   supabase secrets set RAG_VECTOR_RESULTS=10
#   supabase secrets set RAG_KEYWORD_RESULTS=10
#   supabase secrets set RAG_FINAL_RESULTS=6
#   supabase secrets set RAG_EMBEDDING_BATCH_SIZE=16
#
# NOTE: RAG_EMBEDDING_DIM MUST match the dimension of OLLAMA_EMBEDDING_MODEL.
#   bge-m3  -> 1024  (default)
#   nomic-embed-text -> 768
#   mxbai-embed-large -> 1024
#
# If Ollama is unavailable, keyword search still works and the assistant
# returns retrieved sources without an AI-generated answer.

# =====================================================================
# data.gov.in (OGD) proxy — server-side secrets
# =====================================================================
# Powers the Dashboard "Mandi Prices" widget (Agmarknet daily prices).
# The API key is NEVER a Vite variable — it lives in Edge Function secrets
# and is only used by supabase/functions/ogd-proxy.
#
# 1. Register free at https://data.gov.in to get an API key.
# 2. Set the secret and deploy:
#      supabase secrets set OGDINDIA_API_KEY=your_data_gov_in_key
#      supabase functions deploy ogd-proxy
#
# Optional: override the default Agmarknet resource id if you prefer a
# different mandi-prices dataset:
#      supabase secrets set OGD_MANDI_RESOURCE_ID=your_resource_id
#

# =====================================================================
# Resend Email API for Officer Email OTP Verification (Registration & Login)
# =====================================================================
# 1. Create a free account at https://resend.com (3,000 emails/month free)
# 2. Get your API key (starts with re_...)
# 3. For Edge Functions, set server secret:
#      supabase secrets set RESEND_API_KEY=re_your_resend_key
#      supabase secrets set RESEND_FROM_EMAIL="Agronix Portal <onboarding@resend.dev>"
# 4. Optional for direct client-side fallback:
VITE_RESEND_API_KEY=
VITE_RESEND_FROM_EMAIL=Agronix Portal <onboarding@resend.dev>


# =====================================================================
# Web Push Notifications (officers) — VAPID key pair
# =====================================================================
# 1. Generate a key pair (public key goes here, private stays server-side):
#      npx web-push generate-vapid-keys
# 2. Set the PUBLIC key here so the browser can subscribe:
VITE_VAPID_PUBLIC_KEY=
# 3. Set the private key + subject as Supabase secrets (NEVER in Vite env):
#      supabase secrets set VAPID_PUBLIC_KEY=<same public key>
#      supabase secrets set VAPID_PRIVATE_KEY=<private key>
#      supabase secrets set VAPID_SUBJECT=mailto:admin@example.com
# 4. Apply the push_subscriptions migration, then deploy:
#      supabase db push
#      supabase functions deploy push-notify
#
# 5. Server-to-server bridge secret (DB trigger -> push-notify via pg_net):
#      supabase secrets set PUSH_NOTIFY_SECRET=<random long string>
#    Then point the trigger at this project (SQL editor):
#      insert into private.push_notify_config (endpoint, secret)
#      values ('https://<project-ref>.supabase.co/functions/v1/push-notify', '<PUSH_NOTIFY_SECRET>');
#
# Note: iOS requires the PWA installed to the home screen (iOS 16.4+).
