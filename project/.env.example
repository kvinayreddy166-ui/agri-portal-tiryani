VITE_SUPABASE_URL=https://szxtfeiswxugxukztnst.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Dashboard widgets (optional)
# Google Maps: interactive 3D terrain; without key, satellite iframe is shown
VITE_GOOGLE_MAPS_API_KEY=
# OpenWeather: if empty, weather uses free Open-Meteo for Tiryani Mandal
VITE_OPENWEATHER_API_KEY=

# Crop disease AI — optional TensorFlow.js model URL (PlantVillage-style)
VITE_CROP_MODEL_URL=

# External Urea Dashboard (for admin sync)
# These should be set in Supabase Edge Function environment variables, not here
# UREA_DASHBOARD_URL=http://74.225.14.186:8025/dashboard
# UREA_DASHBOARD_USERNAME=your_dashboard_username
# UREA_DASHBOARD_PASSWORD=your_dashboard_password

# Remote Sensing / Google Earth Engine
# Live Sentinel/GEE credentials belong in Supabase Edge Function secrets, not Vite frontend env.
# Function: supabase/functions/remote-sensing-live
# supabase secrets set GEE_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"...","project_id":"..."}'

# =====================================================================
# Knowledge Base (RAG) — server-side secrets (set via `supabase secrets set`)
# =====================================================================
# These are NOT Vite env vars (no VITE_ prefix) — they live in Supabase
# Edge Function secrets and are never exposed to the browser.
#
#   supabase secrets set OLLAMA_BASE_URL=http://your-ollama-server:11434
#   supabase secrets set OLLAMA_CHAT_MODEL=llama3.2
#   supabase secrets set OLLAMA_EMBEDDING_MODEL=bge-m3
#   supabase secrets set RAG_EMBEDDING_DIM=1024
#   supabase secrets set RAG_ENABLED=true
#   supabase secrets set RAG_VECTOR_RESULTS=10
#   supabase secrets set RAG_KEYWORD_RESULTS=10
#   supabase secrets set RAG_FINAL_RESULTS=6
#   supabase secrets set RAG_EMBEDDING_BATCH_SIZE=16
#
# NOTE: RAG_EMBEDDING_DIM MUST match the dimension of OLLAMA_EMBEDDING_MODEL.
#   bge-m3  -> 1024  (default)
#   nomic-embed-text -> 768
#   mxbai-embed-large -> 1024
#
# If Ollama is unavailable, keyword search still works and the assistant
# returns retrieved sources without an AI-generated answer.
