VITE_SUPABASE_URL=https://szxtfeiswxugxukztnst.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Dashboard widgets (optional)
# Google Maps: interactive 3D terrain; without key, satellite iframe is shown
VITE_GOOGLE_MAPS_API_KEY=
# OpenWeather: if empty, weather uses free Open-Meteo for Tiryani Mandal
VITE_OPENWEATHER_API_KEY=

# Crop disease AI — optional TensorFlow.js model URL (PlantVillage-style)
VITE_CROP_MODEL_URL=

# External Urea Dashboard (for admin sync)
# These should be set in Supabase Edge Function environment variables, not here
# UREA_DASHBOARD_URL=http://74.225.14.186:8025/dashboard
# UREA_DASHBOARD_USERNAME=your_dashboard_username
# UREA_DASHBOARD_PASSWORD=your_dashboard_password

# Remote Sensing / Google Earth Engine
# Live Sentinel/GEE credentials belong in Supabase Edge Function secrets, not Vite frontend env.
